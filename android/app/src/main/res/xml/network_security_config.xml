<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (no user-installed CAs). The app's single
     network request is the CBAR rate file on https://www.cbar.az. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
